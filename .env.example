# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5-5
# Solo si la clave es de usuario (sk-ant-usr...): ID del workspace (Console > Settings > Workspaces)
ANTHROPIC_WORKSPACE_ID=

# --- WhatsApp Cloud API (Meta) ---
# Token permanente de un System User (Business Manager > Usuarios del sistema)
WA_TOKEN=EAAG...
WA_PHONE_NUMBER_ID=123456789012345
# App Dashboard > Configuración > Básica > Clave secreta de la app
WA_APP_SECRET=abc123...
# Cadena inventada por ti; se repite en la config del webhook en Meta
WA_VERIFY_TOKEN=andesorto-verify-2026
WA_API_VERSION=v21.0

# --- Derivación ---
# Número del dueño/soporte en formato internacional sin "+" (ej. 51987654321)
OWNER_WA_NUMBER=51987654321
# Plantilla aprobada en WhatsApp Manager (vacío = solo texto libre)
OWNER_TEMPLATE_NAME=alerta_derivacion
OWNER_TEMPLATE_LANG=es
HANDOFF_TIMEOUT_HOURS=24

# --- Otros ---
DB_PATH=andesorto.db
HISTORY_LIMIT=20

# --- Formularios de pedido / reparación ---
# URL pública del servidor (la del túnel en pruebas, el dominio en producción)
PUBLIC_BASE_URL=https://su-dominio.com
# Clave para firmar los enlaces del formulario (cualquier texto largo)
FORM_SECRET=
FORM_LINK_HOURS=72
# WhatsApp de quien recibe las solicitudes (Karla), formato 51XXXXXXXXX
NOTIFY_WA_NUMBER=
# Plantilla aprobada para el aviso de solicitud (opcional, vacío = solo texto libre)
NOTIFY_TEMPLATE_NAME=
# Google Sheet: URL /exec del Apps Script y la misma clave SECRET puesta en Code.gs
SHEETS_WEBHOOK_URL=
SHEETS_SECRET=
